@page "{id:int}"
@model SiriVajiranana_Web.Pages.Admin.Students.EditModel
@{
    ViewData["Title"] = "Edit Student";
}

<div class="edit-container">
    <div class="header-section">
        <div class="header-content">
            <a asp-page="/Admin/Students/ViewResults" class="btn-back"><i class="fa-solid fa-arrow-left"></i></a>
            <div>
                <h1>Edit Student Record</h1>
                <p>Modify registration details and academic performance for <span class="student-name">@Model.Student.Name</span></p>
            </div>
        </div>
    </div>



    <form method="post" class="modern-form">
        <input type="hidden" asp-for="Student.Registration_No" />

        <!-- Personal Information Section -->
        <div class="form-section shadow-premium">
            <h2 class="section-title"><i class="fa-solid fa-user-gear"></i> Personal Information</h2>
            <div class="form-grid">
                <div class="form-group readonly">
                    <label>Registration Number</label>
                    <div class="readonly-value">@Model.Student.Registration_No</div>
                </div>

                <div class="form-group">
                    <label asp-for="Student.Name">Full Name <span class="required-star">*</span></label>
                    <input asp-for="Student.Name" class="form-control" placeholder="Enter student's full name" required />
                    <span asp-validation-for="Student.Name" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Student.Gender">Gender <span class="required-star">*</span></label>
                    <select asp-for="Student.Gender" class="form-control" required>
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <span asp-validation-for="Student.Gender" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Student.Telephone_No">Telephone No <span class="required-star">*</span></label>
                    <input asp-for="Student.Telephone_No" class="form-control" placeholder="Enter phone number" required />
                    <span asp-validation-for="Student.Telephone_No" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Student.Year_of_Admission">Year of Admission <span class="required-star">*</span></label>
                    <input asp-for="Student.Year_of_Admission" class="form-control" placeholder="YYYY" required />
                    <span asp-validation-for="Student.Year_of_Admission" class="validation-error"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Student.Address">Address <span class="required-star">*</span></label>
                    <textarea asp-for="Student.Address" class="form-control" rows="2" placeholder="Enter permanent address" required></textarea>
                    <span asp-validation-for="Student.Address" class="validation-error"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Student.Other_Skills">Other Skills / Notes</label>
                    <textarea asp-for="Student.Other_Skills" class="form-control" rows="2" placeholder="Any additional information"></textarea>
                </div>
            </div>
        </div>

        <!-- Academic Records Section -->
        <div class="form-section shadow-premium">
            <h2 class="section-title"><i class="fa-solid fa-graduation-cap"></i> Academic Records (Grades 05 - 11)</h2>
            <div class="grades-grid">
                @for (int g = 5; g <= 11; g++)
                {
                    string gradeStr = g.ToString("D2");
                    <div class="grade-card">
                        <div class="grade-header">Grade @gradeStr</div>
                        <div class="grade-inputs">
                            <div class="input-card">
                                <label>Buddhism</label>
                                <input name="Student.Grade@(gradeStr)_Buddhism" value="@Model.Student.GetType().GetProperty("Grade" + gradeStr + "_Buddhism")?.GetValue(Model.Student)" class="form-control sm" />
                            </div>
                            <div class="input-card">
                                <label>Abhidhamma</label>
                                <input name="Student.Grade@(gradeStr)_Abhidhamma" value="@Model.Student.GetType().GetProperty("Grade" + gradeStr + "_Abhidhamma")?.GetValue(Model.Student)" class="form-control sm" />
                            </div>
                            <div class="input-card">
                                <label>Pali</label>
                                <input name="Student.Grade@(gradeStr)_Pali" value="@Model.Student.GetType().GetProperty("Grade" + gradeStr + "_Pali")?.GetValue(Model.Student)" class="form-control sm" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Sticky Actions -->
        <div class="form-actions glass-effect">
            <a href="/Admin/Students/ViewResults" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-cloud-arrow-up"></i> Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    title: '<span style="color: #f8fafc; font-family: \'Outfit\', sans-serif;">Success!</span>',
                    html: `<span style="color: #94a3b8; font-family: 'Outfit', sans-serif;">@Html.Raw(Model.Message.Replace("`", "\\`"))</span>`,
                    icon: 'success',
                    background: '#1e293b',
                    confirmButtonColor: '#10b981',
                    customClass: { popup: 'swal2-premium-popup', title: 'swal2-premium-title', confirmButton: 'swal2-premium-confirm' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Admin/Students/ViewResults';
                    }
                });
            });
            </text>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    title: '<span style="color: #f8fafc; font-family: \'Outfit\', sans-serif;">Error!</span>',
                    html: `<span style="color: #94a3b8; font-family: 'Outfit', sans-serif;">@Html.Raw(Model.ErrorMessage.Replace("`", "\\`"))</span>`,
                    icon: 'error',
                    background: '#1e293b',
                    confirmButtonColor: '#ef4444',
                    customClass: { popup: 'swal2-premium-popup', title: 'swal2-premium-title', confirmButton: 'swal2-premium-confirm' }
                });
            });
            </text>
        }
    </script>
}

<style>
    .edit-container { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }

    .header-section { margin-bottom: 2.5rem; }
    .header-content { display: flex; align-items: flex-start; gap: 1.5rem; }
    .header-section h1 { font-size: 2rem; margin: 0; color: #f8fafc; font-weight: 700; }
    .header-section p { color: #94a3b8; margin-top: 0.5rem; }
    .student-name { color: var(--primary); font-weight: 600; }

    .btn-back {
        width: 40px; height: 40px; border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        display: flex; align-items: center; justify-content: center;
        color: #94a3b8; text-decoration: none; transition: all 0.2s;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .btn-back:hover { background: var(--primary); color: white; border-color: var(--primary); }

    .modern-form { display: flex; flex-direction: column; gap: 2rem; }

    .form-section {
        background: var(--surface);
        padding: 2.5rem;
        border-radius: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
        margin-bottom: 3rem;
    }

    .section-title {
        font-size: 1.25rem; font-weight: 600; margin-bottom: 2rem;
        display: flex; align-items: center; gap: 0.75rem; color: #f8fafc;
    }
    .section-title i { color: var(--primary); }

    .validation-error {
        color: #ef4444;
        font-size: 0.8rem;
        margin-top: 0.4rem;
        display: block;
    }

    .required-star {
        color: #ef4444;
        font-weight: bold;
        margin-left: 2px;
    }

    .form-grid { 
        display: grid; 
        grid-template-columns: repeat(3, 1fr); 
        gap: 2rem 2.5rem; 
    }
    .form-group.full-width { grid-column: span 3; }

    .form-group label { display: block; font-size: 0.9rem; color: #94a3b8; margin-bottom: 0.8rem; font-weight: 500; }

    .form-control {
        width: 100%; background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem; padding: 0.8rem 1rem; color: white;
        transition: all 0.2s; font-family: 'Outfit', sans-serif;
    }
    .form-control:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1); }

    .readonly-value {
        padding: 0.8rem 1rem; background: rgba(255, 255, 255, 0.03);
        border-radius: 0.75rem; color: #64748b; font-weight: 600; border: 1px dashed rgba(255, 255, 255, 0.1);
    }

    /* Grades Grid */
    .grades-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; }
    .grade-card { background: rgba(255, 255, 255, 0.02); padding: 2.5rem; border-radius: 1.5rem; border: 1px solid rgba(255, 255, 255, 0.05); transition: all 0.3s ease; }
    .grade-card:hover { background: rgba(255, 255, 255, 0.04); border-color: rgba(99, 102, 241, 0.2); transform: translateY(-2px); }
    .grade-header { font-weight: 700; color: var(--primary); margin-bottom: 2rem; font-size: 1.2rem; border-bottom: 1px solid rgba(255, 255, 255, 0.05); padding-bottom: 1rem; }
    
    .grade-inputs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .input-card { display: flex; flex-direction: column; gap: 0.75rem; }
    .input-card label { font-size: 0.8rem; color: #64748b; text-align: center; letter-spacing: 0.03em; }
    .form-control.sm { padding: 0.75rem 0.5rem; text-align: center; font-size: 0.9rem; }

    /* Actions */
    .form-actions {
        display: flex; gap: 1.5rem; justify-content: flex-end;
        position: sticky; bottom: 0; 
        margin-top: 4rem;
        padding: 2rem 0;
        background: var(--bg);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        z-index: 1000;
        box-shadow: 0 -20px 20px -10px var(--bg);
    }

    .btn {
        padding: 0.9rem 2rem; border-radius: 0.75rem; font-weight: 600;
        cursor: pointer; display: inline-flex; align-items: center; gap: 0.75rem;
        transition: all 0.3s; text-decoration: none; border: none; font-size: 1rem;
    }
    .btn-primary { background: var(--primary); color: white; box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3); }
    .btn-primary:hover { background: var(--primary-hover); transform: translateY(-3px); box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.4); }

    .btn-outline { background: transparent; color: #94a3b8; border: 1px solid rgba(255, 255, 255, 0.1); }
    .btn-outline:hover { background: rgba(255, 255, 255, 0.05); color: white; }

    /* Custom SweetAlert2 Styles to match theme */
    .swal2-premium-popup {
        border-radius: 1.25rem !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
    }
    .swal2-premium-title { font-family: 'Outfit', sans-serif !important; }
    .swal2-premium-confirm, .swal2-premium-cancel {
        font-family: 'Outfit', sans-serif !important;
        font-weight: 600 !important;
        padding: 0.75rem 1.5rem !important;
        border-radius: 0.75rem !important;
    }

    @@media (max-width: 992px) {
        .form-actions { left: 2rem; }
    }
</style>
