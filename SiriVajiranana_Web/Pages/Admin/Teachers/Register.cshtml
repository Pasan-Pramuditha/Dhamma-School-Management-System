@page
@model SiriVajiranana_Web.Pages.Admin.Teachers.RegisterModel
@{
    ViewData["Title"] = "Register Teacher";
}

<div class="register-container">
    <div class="header-section">
        <h1>Teacher Registration</h1>
        <p>Enter teacher details and appointment information.</p>
    </div>

    <form method="post" class="modern-form">
        <div class="form-section">
            <h2 class="section-title"><i class="fa-solid fa-user-tie"></i> Teacher Information</h2>
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Teacher.TeacherID">Teacher ID</label>
                    <input asp-for="Teacher.TeacherID" class="form-control" placeholder="Enter ID" />
                    <span asp-validation-for="Teacher.TeacherID" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Teacher.Name">Full Name</label>
                    <input asp-for="Teacher.Name" class="form-control" placeholder="Enter teacher's full name" />
                    <span asp-validation-for="Teacher.Name" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Teacher.Gender">Gender</label>
                    <select asp-for="Teacher.Gender" class="form-control">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                    <span asp-validation-for="Teacher.Gender" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Teacher.NIC">NIC Number</label>
                    <input asp-for="Teacher.NIC" class="form-control" placeholder="Enter NIC" />
                    <span asp-validation-for="Teacher.NIC" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Teacher.Telephone_No">Telephone No</label>
                    <input asp-for="Teacher.Telephone_No" class="form-control" placeholder="Enter phone number" />
                    <span asp-validation-for="Teacher.Telephone_No" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Teacher.Email">Email (Optional)</label>
                    <input asp-for="Teacher.Email" class="form-control" placeholder="Enter email address" />
                    <span asp-validation-for="Teacher.Email" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Teacher.Year_of_Appointment">Year of Appointment</label>
                    <input asp-for="Teacher.Year_of_Appointment" class="form-control" placeholder="YYYY" />
                    <span asp-validation-for="Teacher.Year_of_Appointment" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Teacher.Subject">Subject</label>
                    <input asp-for="Teacher.Subject" class="form-control" placeholder="Enter subject" />
                    <span asp-validation-for="Teacher.Subject" class="validation-error"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Teacher.Address">Address</label>
                    <textarea asp-for="Teacher.Address" class="form-control" rows="2" placeholder="Enter permanent address"></textarea>
                    <span asp-validation-for="Teacher.Address" class="validation-error"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a href="/Admin/Dashboard" class="btn btn-cancel"><i class="fas fa-times"></i> Cancel</a>
            <button type="submit" asp-page-handler="Save" class="btn btn-primary"><i class="fas fa-save"></i> Save Teacher</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    title: '<span style="color: #f8fafc; font-family: \'Outfit\', sans-serif;">Success!</span>',
                    html: `<span style="color: #94a3b8; font-family: 'Outfit', sans-serif;">@Html.Raw(Model.Message.Replace("`", "\\`"))</span>`,
                    icon: 'success',
                    background: '#1e293b',
                    confirmButtonColor: '#10b981',
                    customClass: { popup: 'swal2-premium-popup', title: 'swal2-premium-title', confirmButton: 'swal2-premium-confirm' }
                }).then(() => {
                    window.location.href = '/Admin/Teachers/Register';
                });
            });
            </text>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    title: '<span style="color: #f8fafc; font-family: \'Outfit\', sans-serif;">Error!</span>',
                    html: `<span style="color: #94a3b8; font-family: 'Outfit', sans-serif;">@Html.Raw(Model.ErrorMessage.Replace("`", "\\`"))</span>`,
                    icon: 'error',
                    background: '#1e293b',
                    confirmButtonColor: '#ef4444',
                    customClass: { popup: 'swal2-premium-popup', title: 'swal2-premium-title', confirmButton: 'swal2-premium-confirm' }
                });
            });
            </text>
        }
    </script>
}

<style>
    .register-container {
        max-width: 1000px;
        margin: 0 auto;
        padding-bottom: 5rem;
    }

    .header-section { margin-bottom: 2.5rem; }
    .header-section h1 { font-size: 2.2rem; margin: 0; }
    .header-section p { color: var(--text-muted); margin-top: 0.5rem; }

    .modern-form {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .form-section {
        background: var(--surface);
        padding: 2rem;
        border-radius: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .section-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--primary);
    }

    .validation-error {
        color: #ef4444;
        font-size: 0.8rem;
        margin-top: 0.4rem;
        display: block;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem 2.5rem;
    }

    .form-group.full-width { grid-column: span 3; }

    .form-group label {
        display: block;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0.8rem;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        color: white;
        font-family: inherit;
        transition: all 0.2s;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    }

    .form-actions {
        display: flex;
        gap: 1.5rem;
        justify-content: flex-end;
        position: sticky;
        bottom: 0;
        margin-top: 4rem;
        padding: 2rem 0;
        background: var(--bg);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        z-index: 1000;
        box-shadow: 0 -20px 20px -10px var(--bg);
    }

    .btn {
        padding: 0.8rem 1.5rem;
        border: none;
        border-radius: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        text-decoration: none;
    }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); transform: translateY(-2px); }

    .btn-cancel {
        color: var(--text-muted);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .btn-cancel:hover { background: rgba(239, 68, 68, 0.08); border-color: rgba(239, 68, 68, 0.3); color: #ef4444; transform: translateY(-2px); }
</style>
